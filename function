<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>M Convention</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
}

body{
  background:#f4f7fb;
  color:#222;
  padding-bottom:75px;
}

header{
  background:linear-gradient(135deg,#8e2de2,#ff416c);
  color:white;
  padding:22px 18px;
  text-align:center;
}

header h1{
  font-size:30px;
}

header p{
  margin-top:5px;
  opacity:.9;
}

.logo{
  width:75px;
  height:75px;
  border-radius:50%;
  background:white;
  color:#e52d4f;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:45px;
  font-weight:bold;
  margin:15px auto;
  box-shadow:0 5px 20px #0003;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:15px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}

.card{
  background:white;
  border-radius:15px;
  padding:18px;
  box-shadow:0 3px 15px #0001;
}

.card small{
  color:#777;
}

.card h2{
  margin-top:8px;
  color:#d92d55;
}

button{
  border:0;
  border-radius:9px;
  padding:11px 16px;
  cursor:pointer;
  font-weight:bold;
}

.primary{
  width:100%;
  margin:15px 0;
  color:white;
  background:linear-gradient(90deg,#ff416c,#8e2de2);
}

.secondary{
  background:#eee;
}

.danger{
  background:#ff4d4d;
  color:white;
}

.success{
  background:#19a974;
  color:white;
}

.section{
  display:none;
}

.section.active{
  display:block;
}

.title{
  margin:20px 0 12px;
  font-size:22px;
}

.form{
  background:white;
  padding:18px;
  border-radius:15px;
  box-shadow:0 3px 15px #0001;
}

.grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

label{
  font-size:13px;
  font-weight:bold;
  color:#555;
}

input,select,textarea{
  width:100%;
  margin-top:5px;
  padding:12px;
  border:1px solid #ddd;
  border-radius:8px;
  outline:none;
}

textarea{
  min-height:80px;
  resize:vertical;
}

.full{
  grid-column:1/-1;
}

table{
  width:100%;
  border-collapse:collapse;
  background:white;
  border-radius:12px;
  overflow:hidden;
}

th,td{
  padding:10px;
  border-bottom:1px solid #eee;
  text-align:left;
  font-size:13px;
}

th{
  background:#f0e8ff;
}

.badge{
  padding:5px 8px;
  border-radius:20px;
  font-size:11px;
  font-weight:bold;
}

.paid{
  background:#d8f8e7;
  color:#087443;
}

.pending{
  background:#ffe0e0;
  color:#b00020;
}

.calendar-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin:15px 0;
}

.calendar{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:5px;
}

.day-name{
  text-align:center;
  font-weight:bold;
  padding:8px 2px;
  font-size:12px;
}

.day{
  min-height:80px;
  background:white;
  border-radius:9px;
  padding:6px;
  box-shadow:0 2px 8px #0001;
}

.day.empty{
  background:transparent;
  box-shadow:none;
}

.day strong{
  font-size:13px;
}

.booked{
  background:#ffe0ea;
  border:2px solid #ff416c;
}

.slot{
  display:block;
  font-size:9px;
  margin-top:4px;
  padding:3px;
  background:#8e2de2;
  color:white;
  border-radius:4px;
}

.nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  background:white;
  display:flex;
  justify-content:space-around;
  padding:8px 3px;
  box-shadow:0 -3px 15px #0002;
  z-index:20;
}

.nav button{
  background:none;
  padding:6px;
  font-size:11px;
  color:#555;
}

.nav button.active{
  color:#d92d55;
  font-weight:bold;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:#0008;
  z-index:50;
  overflow:auto;
  padding:20px;
}

.modal-box{
  background:white;
  max-width:650px;
  margin:20px auto;
  border-radius:15px;
  padding:20px;
}

.close{
  float:right;
  background:#eee;
  border-radius:50%;
  width:35px;
  height:35px;
}

.empty{
  text-align:center;
  padding:30px;
  color:#777;
}

.note{
  background:#fffbd1;
  padding:15px;
  border-radius:10px;
  margin-bottom:10px;
}

@media(max-width:700px){
  .cards{
    grid-template-columns:repeat(2,1fr);
  }

  .grid{
    grid-template-columns:1fr;
  }

  .full{
    grid-column:auto;
  }

  table{
    display:block;
    overflow-x:auto;
  }

  .day{
    min-height:60px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">M</div>
  <h1>M Convention</h1>
  <p>Convention Hall Management</p>
</header>

<div class="container">

<!-- HOME -->
<section id="home" class="section active">

  <div class="cards">
    <div class="card">
      <small>Today's Bookings</small>
      <h2 id="todayCount">0</h2>
    </div>

    <div class="card">
      <small>This Month</small>
      <h2 id="monthCount">0</h2>
    </div>

    <div class="card">
      <small>Received</small>
      <h2 id="receivedAmount">₹0</h2>
    </div>

    <div class="card">
      <small>Pending</small>
      <h2 id="pendingAmount">₹0</h2>
    </div>
  </div>

  <button class="primary" onclick="openBooking()">
    + ADD NEW BOOKING
  </button>

  <h2 class="title">Calendar</h2>

  <div class="form">
    <div class="calendar-head">
      <button class="secondary" onclick="changeMonth(-1)">‹</button>
      <h3 id="monthTitle"></h3>
      <button class="secondary" onclick="changeMonth(1)">›</button>
    </div>

    <div id="calendar" class="calendar"></div>
  </div>

  <h2 class="title">Upcoming Events</h2>
  <div id="upcoming"></div>

</section>


<!-- BOOKINGS -->
<section id="bookings" class="section">

  <h2 class="title">Bookings</h2>

  <button class="primary" onclick="openBooking()">
    + ADD NEW BOOKING
  </button>

  <div class="form">
    <input id="bookingSearch"
           placeholder="Search customer / phone..."
           oninput="renderBookings()">
  </div>

  <br>

  <div id="bookingList"></div>

</section>


<!-- CUSTOMERS -->
<section id="customers" class="section">
  <h2 class="title">Customers</h2>

  <div class="form" style="margin-bottom:12px;">
    <input id="customerSearch"
           placeholder="Search customer name / phone..."
           oninput="renderCustomers()">
  </div>

  <div id="customerList"></div>
</section>

<!-- CUSTOMER DETAILS MODAL -->
<div id="customerDetailsModal" class="modal">
  <div class="modal-box">
    <button class="close" onclick="closeCustomerDetails()">×</button>
    <h2 id="customerDetailsTitle">Customer Details</h2>
    <br>
    <div id="customerDetailsBody"></div>
  </div>
</div>



<!-- STAFF -->
<section id="staff" class="section">
  <h2 class="title">Staff Management</h2>
  <button class="primary" onclick="openStaff()">+ ADD STAFF</button>
  <div id="staffList"></div>
</section>

<div id="staffModal" class="modal">
  <div class="modal-box">
    <button class="close" onclick="closeStaff()">×</button>
    <h2 id="staffTitle">Add Staff</h2><br>
    <div class="grid">
      <div><label>Staff Name</label><input id="sName"></div>
      <div><label>Phone Number</label><input id="sPhone" type="tel"></div>
      <div class="full"><label>Address</label><textarea id="sAddress"></textarea></div>
      <div><label>Joining Date</label><input id="sJoiningDate" type="date"></div>
      <div><label>Monthly Salary ₹</label><input id="sSalary" type="number" min="0"></div>
      <div><label>Advance Taken ₹</label><input id="sAdvance" type="number" min="0" value="0"></div>
    </div>
    <br><button class="primary" onclick="saveStaff()">SAVE STAFF</button>
  </div>
</div>

<div id="attendanceModal" class="modal">
  <div class="modal-box">
    <button class="close" onclick="closeAttendance()">×</button>
    <h2 id="attendanceTitle">Attendance</h2><br>
    <label>Month</label>
    <input id="aMonth" type="month" onchange="renderAttendance()">
    <br><br>
    <div id="attendanceBody"></div>
    <br><button class="primary" onclick="saveAttendance()">SAVE ATTENDANCE</button>
  </div>
</div>

<!-- EXPENSES -->
<section id="expenses" class="section">

  <h2 class="title">Expenses</h2>

  <button class="primary" onclick="openExpense()">
    + ADD EXPENSE
  </button>

  <div id="expenseList"></div>

</section>


<!-- REPORTS -->
<section id="reports" class="section">

  <h2 class="title">Reports</h2>

  <div class="cards">

    <div class="card">
      <small>Total Booking Value</small>
      <h2 id="reportTotal">₹0</h2>
    </div>

    <div class="card">
      <small>Total Received</small>
      <h2 id="reportReceived">₹0</h2>
    </div>

    <div class="card">
      <small>Total Pending</small>
      <h2 id="reportPending">₹0</h2>
    </div>

    <div class="card">
      <small>Total Expenses</small>
      <h2 id="reportExpenses">₹0</h2>
    </div>

  </div>

  <h2 class="title">Financial Summary</h2>

  <div class="form">
    <p>Total Income: <b id="rIncome">₹0</b></p>
    <br>
    <p>Total Expenses: <b id="rExpense">₹0</b></p>
    <br>
    <p>Balance: <b id="rBalance">₹0</b></p>
  </div>

</section>


<!-- NOTES -->
<section id="notes" class="section">

  <h2 class="title">Notes</h2>

  <div class="form">
    <textarea id="noteText"
      placeholder="Write your note..."></textarea>

    <button class="primary" onclick="addNote()">
      + SAVE NOTE
    </button>
  </div>

  <br>

  <div id="noteList"></div>

</section>

</div>


<!-- BOTTOM NAV -->
<div class="nav">

  <button id="nav-home"
          class="active"
          onclick="showSection('home')">
    🏠<br>Home
  </button>

  <button id="nav-bookings"
          onclick="showSection('bookings')">
    📅<br>Bookings
  </button>

  <button id="nav-customers"
          onclick="showSection('customers')">
    👥<br>Customers
  </button>

  <button id="nav-expenses"
          onclick="showSection('expenses')">
    💰<br>Expenses
  </button>

  <button id="nav-reports"
          onclick="showSection('reports')">
    📊<br>Reports
  </button>

</div>


<!-- BOOKING MODAL -->
<div id="bookingModal" class="modal">

  <div class="modal-box">

    <button class="close"
            onclick="closeBooking()">×</button>

    <h2 id="bookingTitle">New Booking</h2>

    <br>

    <div class="grid">

      <div>
        <label>Customer Name</label>
        <input id="bName">
      </div>

      <div>
        <label>Phone Number</label>
        <input id="bPhone"
               type="tel">
      </div>

      <div>
        <label>Event Type</label>
        <select id="bEvent">
          <option>Marriage</option>
          <option>Reception</option>
          <option>Birthday</option>
          <option>Meeting</option>
          <option>Other</option>
        </select>
      </div>

      <div>
        <label>Event Date</label>
        <input id="bDate"
               type="date">
      </div>

      <div>
        <label>Event Slot</label>
        <select id="bSlot">
          <option>Afternoon</option>
          <option>Night</option>
        </select>
      </div>

      <div>
        <label>Event Time</label>
        <input id="bTime"
               type="time">
      </div>

      <div>
        <label>Number of Guests</label>
        <input id="bGuests"
               type="number"
               min="0">
      </div>

      <div>
        <label>Total Amount ₹</label>
        <input id="bTotal"
               type="number"
               min="0"
               step="1"
               placeholder="Example: 890">
      </div>

      <div>
        <label>Advance Received ₹</label>
        <input id="bAdvance"
               type="number"
               min="0"
               step="1"
               value="0">
      </div>

      <div>
        <label>Payment Source</label>
        <select id="bSource">
          <option>Cash</option>
          <option>PhonePe</option>
          <option>Bank Account</option>
          <option>Other</option>
        </select>
      </div>

      <div class="full">
        <label>Reference</label>
        <input id="bReference">
      </div>

      <div class="full">
        <label>Notes</label>
        <textarea id="bNotes"></textarea>
      </div>

    </div>

    <br>

    <button class="primary"
            onclick="saveBooking()">
      SAVE BOOKING
    </button>

  </div>

</div>


<!-- PAYMENT MODAL -->
<div id="paymentModal" class="modal">
  <div class="modal-box">
    <button class="close" onclick="closePayment()">×</button>
    <h2 id="paymentTitle">Add Payment</h2>
    <br>
    <div id="paymentBookingInfo" class="note" style="background:#f5efff"></div>
    <div class="grid">
      <div>
        <label>Payment Amount ₹</label>
        <input id="pAmount" type="number" min="1" step="1">
      </div>
      <div>
        <label>Payment Date</label>
        <input id="pDate" type="date">
      </div>
      <div>
        <label>Payment Source</label>
        <select id="pSource">
          <option>Cash</option>
          <option>PhonePe</option>
          <option>Bank Account</option>
          <option>Other</option>
        </select>
      </div>
      <div>
        <label>Reference</label>
        <input id="pReference" placeholder="Receipt / transaction no.">
      </div>
      <div class="full">
        <label>Notes</label>
        <textarea id="pNotes" placeholder="Payment notes..."></textarea>
      </div>
    </div>
    <br>
    <button class="primary" onclick="savePayment()">SAVE PAYMENT</button>
  </div>
</div>

<!-- PAYMENT HISTORY MODAL -->
<div id="paymentHistoryModal" class="modal">
  <div class="modal-box">
    <button class="close" onclick="closePaymentHistory()">×</button>
    <h2>Payment History</h2>
    <br>
    <div id="paymentHistory"></div>
  </div>
</div>

<!-- EXPENSE MODAL -->
<div id="expenseModal" class="modal">

  <div class="modal-box">

    <button class="close"
            onclick="closeExpense()">×</button>

    <h2>Add Expense</h2>

    <br>

    <label>Purpose</label>
    <input id="ePurpose">

    <br><br>

    <label>Amount ₹</label>
    <input id="eAmount"
           type="number"
           min="0">

    <br><br>

    <label>Date</label>
    <input id="eDate"
           type="date">

    <br><br>

    <label>Payment Source</label>
    <select id="eSource">
      <option>Cash</option>
      <option>PhonePe</option>
      <option>Bank Account</option>
    </select>

    <br><br>

    <label>Status</label>
    <select id="eStatus">
      <option>Settled</option>
      <option>Pending</option>
    </select>

    <button class="primary"
            onclick="saveExpense()">
      SAVE EXPENSE
    </button>

  </div>

</div>


<script>

let bookings =
  JSON.parse(localStorage.getItem("mConventionBookings") || "[]");

let expenses =
  JSON.parse(localStorage.getItem("mConventionExpenses") || "[]");

let notes =
  JSON.parse(localStorage.getItem("mConventionNotes") || "[]");

let payments =
  JSON.parse(localStorage.getItem("mConventionPayments") || "[]");

let paymentBookingId = null;
let paymentEditId = null;
let editId = null;

let currentMonth = new Date().getMonth();

let currentYear = new Date().getFullYear();


/* =========================
   STORAGE
========================= */

function saveData(){

  localStorage.setItem(
    "mConventionBookings",
    JSON.stringify(bookings)
  );

  localStorage.setItem(
    "mConventionExpenses",
    JSON.stringify(expenses)
  );

  localStorage.setItem(
    "mConventionNotes",
    JSON.stringify(notes)
  );

  localStorage.setItem(
    "mConventionPayments",
    JSON.stringify(payments)
  );

}


/* =========================
   MONEY
========================= */

function money(value){

  return "₹" +
    Number(value || 0).toLocaleString("en-IN");

}


/* =========================
   NAVIGATION
========================= */

function showSection(id){

  document.querySelectorAll(".section")
    .forEach(s => s.classList.remove("active"));

  document.getElementById(id)
    .classList.add("active");

  document.querySelectorAll(".nav button")
    .forEach(b => b.classList.remove("active"));

  let nav = document.getElementById("nav-" + id);

  if(nav) nav.classList.add("active");

  updateUI();

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

}


/* =========================
   BOOKING MODAL
========================= */

function openBooking(id=null){

  editId = id;

  document.getElementById("bookingModal")
    .style.display="block";

  if(id){

    let b =
      bookings.find(x => x.id === id);

    if(!b) return;

    document.getElementById("bookingTitle")
      .innerText="Edit Booking";

    document.getElementById("bName").value=b.name;
    document.getElementById("bPhone").value=b.phone;
    document.getElementById("bEvent").value=b.event;
    document.getElementById("bDate").value=b.date;
    document.getElementById("bSlot").value=b.slot;
    document.getElementById("bTime").value=b.time;
    document.getElementById("bGuests").value=b.guests;
    document.getElementById("bTotal").value=b.total;
    document.getElementById("bAdvance").value=b.advance;
    document.getElementById("bSource").value=b.source;
    document.getElementById("bReference").value=b.reference || "";
    document.getElementById("bNotes").value=b.notes || "";

  }else{

    document.getElementById("bookingTitle")
      .innerText="New Booking";

    clearBookingForm();

    let d=new Date();

    document.getElementById("bDate").value =
      d.toISOString().split("T")[0];

  }

}


function closeBooking(){

  document.getElementById("bookingModal")
    .style.display="none";

  editId=null;

}


function clearBookingForm(){

  [
    "bName",
    "bPhone",
    "bTime",
    "bGuests",
    "bTotal",
    "bReference",
    "bNotes"
  ].forEach(id=>{
    document.getElementById(id).value="";
  });

  document.getElementById("bAdvance").value=0;
  document.getElementById("bEvent").value="Marriage";
  document.getElementById("bSlot").value="Afternoon";
  document.getElementById("bSource").value="Cash";

}


/* =========================
   SAVE BOOKING
========================= */

function saveBooking(){

  let name =
    document.getElementById("bName").value.trim();

  let phone =
    document.getElementById("bPhone").value.trim();

  let event =
    document.getElementById("bEvent").value;

  let date =
    document.getElementById("bDate").value;

  let slot =
    document.getElementById("bSlot").value;

  let time =
    document.getElementById("bTime").value;

  let guests =
    document.getElementById("bGuests").value;

  let total =
    Number(document.getElementById("bTotal").value || 0);

  let advance =
    Number(document.getElementById("bAdvance").value || 0);

  let source =
    document.getElementById("bSource").value;

  let reference =
    document.getElementById("bReference").value.trim();

  let notesText =
    document.getElementById("bNotes").value.trim();


  if(!name){
    alert("Please enter customer name.");
    return;
  }

  if(!phone){
    alert("Please enter phone number.");
    return;
  }

  if(!date){
    alert("Please select event date.");
    return;
  }

  if(total < 0 || advance < 0){
    alert("Amount cannot be negative.");
    return;
  }

  if(advance > total){
    alert("Advance cannot be more than total amount.");
    return;
  }


  /* PREVENT SAME DATE + SAME SLOT */

  let duplicate =
    bookings.find(x =>
      x.date === date &&
      x.slot === slot &&
      x.id !== editId
    );

  if(duplicate){

    alert(
      "This time slot is already booked on this date.\n\n" +
      "You can use the other slot."
    );

    return;
  }


  let booking={

    id: editId || Date.now(),

    name:name,

    phone:phone,

    event:event,

    date:date,

    slot:slot,

    time:time,

    guests:guests,

    total:total,

    advance:advance,

    balance:Math.max(0,total-advance),

    source:source,

    reference:reference,

    notes:notesText,

    createdAt:new Date().toISOString()

  };


  if(editId){

    let index =
      bookings.findIndex(x => x.id === editId);

    if(index !== -1){
      bookings[index]=booking;
    }

  }else{

    bookings.push(booking);

  }


  saveData();

  closeBooking();

  updateUI();

  alert("Booking saved successfully!");

}


/* =========================
   EDIT / DELETE
========================= */

function editBooking(id){

  openBooking(id);

}


function deleteBooking(id){

  if(!confirm("Delete this booking?")) return;

  bookings =
    bookings.filter(x => x.id !== id);

  payments =
    payments.filter(p => Number(p.bookingId) !== Number(id));

  saveData();

  updateUI();

}


/* =========================
   BOOKING LIST
========================= */

function renderBookings(){

  let box =
    document.getElementById("bookingList");

  let search =
    (document.getElementById("bookingSearch")?.value || "")
    .toLowerCase();

  let list =
    bookings.filter(b =>
      b.name.toLowerCase().includes(search) ||
      b.phone.toLowerCase().includes(search)
    );

  list.sort((a,b)=>
    a.date.localeCompare(b.date)
  );


  if(!list.length){

    box.innerHTML=
      '<div class="empty">No bookings found.</div>';

    return;

  }


  box.innerHTML = list.map(b=>{

    let status =
      b.balance <= 0 ? "Paid" : "Pending";

    return `

      <div class="card" style="margin-bottom:12px">

        <h3>${escapeHTML(b.name)}</h3>

        <p>📞 ${escapeHTML(b.phone)}</p>

