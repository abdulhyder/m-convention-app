function getBookingPayments(bookingId){
  return payments
    .filter(p => Number(p.bookingId) === Number(bookingId))
    .sort((a,b) => b.date.localeCompare(a.date));
}

function getPaidAmount(booking){
  let history = getBookingPayments(booking.id);
  if(history.length){
    return history.reduce((sum,p) => sum + Number(p.amount || 0), 0);
  }
  return Number(booking.advance || 0);
}

function syncBookingPaymentTotals(booking){
  let paid = getPaidAmount(booking);
  booking.advance = paid;
  booking.balance = Math.max(0, Number(booking.total || 0) - paid);
}

function openPayment(bookingId){
  let b = bookings.find(x => Number(x.id) === Number(bookingId));
  if(!b) return;

  paymentBookingId = b.id;
  paymentEditId = null;

  document.getElementById("paymentTitle").innerText = "Add Payment";
  document.getElementById("pAmount").value = "";
  document.getElementById("pDate").value = new Date().toISOString().split("T")[0];
  document.getElementById("pSource").value = "Cash";
  document.getElementById("pReference").value = "";
  document.getElementById("pNotes").value = "";

  let paid = getPaidAmount(b);
  let balance = Math.max(0, Number(b.total || 0) - paid);

  document.getElementById("paymentBookingInfo").innerHTML =
    "<b>" + escapeHTML(b.name) + "</b><br>" +
    "Total: " + money(b.total) +
    " &nbsp; | &nbsp; Paid: " + money(paid) +
    " &nbsp; | &nbsp; Balance: " + money(balance);

  document.getElementById("pAmount").max = balance;
  document.getElementById("paymentModal").style.display = "block";
}

function editPayment(paymentId){
  let p = payments.find(x => Number(x.id) === Number(paymentId));
  if(!p) return;

  let b = bookings.find(x => Number(x.id) === Number(p.bookingId));
  if(!b) return;

  paymentBookingId = b.id;
  paymentEditId = p.id;

  document.getElementById("paymentTitle").innerText = "Edit Payment";
  document.getElementById("pAmount").value = p.amount;
  document.getElementById("pDate").value = p.date;
  document.getElementById("pSource").value = p.source || "Cash";
  document.getElementById("pReference").value = p.reference || "";
  document.getElementById("pNotes").value = p.notes || "";

  let otherPaid = getBookingPayments(b.id)
    .filter(x => Number(x.id) !== Number(p.id))
    .reduce((sum,x) => sum + Number(x.amount || 0), 0);

  document.getElementById("pAmount").max =
    Math.max(0, Number(b.total || 0) - otherPaid);

  document.getElementById("paymentBookingInfo").innerHTML =
    "<b>" + escapeHTML(b.name) + "</b><br>" +
    "Total: " + money(b.total) +
    " &nbsp; | &nbsp; Other payments: " + money(otherPaid);

  document.getElementById("paymentModal").style.display = "block";
}

function savePayment(){
  let b = bookings.find(x => Number(x.id) === Number(paymentBookingId));
  if(!b) return;

  let amount = Number(document.getElementById("pAmount").value || 0);
  let date = document.getElementById("pDate").value;
  let source = document.getElementById("pSource").value;
  let reference = document.getElementById("pReference").value.trim();
  let notesText = document.getElementById("pNotes").value.trim();

  if(amount <= 0){
    alert("Enter a valid payment amount.");
    return;
  }
  if(!date){
    alert("Please select payment date.");
    return;
  }

  let otherPaid = getBookingPayments(b.id)
    .filter(x => Number(x.id) !== Number(paymentEditId))
    .reduce((sum,x) => sum + Number(x.amount || 0), 0);

  if(otherPaid + amount > Number(b.total || 0)){
    alert("Payment cannot be more than the remaining balance.");
    return;
  }

  let payment = {
    id: paymentEditId || Date.now(),
    bookingId: b.id,
    amount: amount,
    date: date,
    source: source,
    reference: reference,
    notes: notesText,
    createdAt: new Date().toISOString()
  };

  if(paymentEditId){
    let i = payments.findIndex(x => Number(x.id) === Number(paymentEditId));
    if(i !== -1) payments[i] = payment;
  }else{
    payments.push(payment);
  }

  syncBookingPaymentTotals(b);
  saveData();
  closePayment();
  updateUI();
  alert("Payment saved successfully!");
}

