  if(!confirm("Delete this payment?")) return;

  let p = payments.find(x => Number(x.id) === Number(paymentId));
  if(!p) return;

  payments = payments.filter(x => Number(x.id) !== Number(paymentId));

  let b = bookings.find(x => Number(x.id) === Number(p.bookingId));
