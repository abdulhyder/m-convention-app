function workingDaysInMonth(month){
  if(!month) return 0;
  let [year,mon]=month.split("-").map(Number);
  return new Date(year,mon,0).getDate();
}

function getStaffAttendance(staffId,month){
  return attendance.find(x=>Number(x.staffId)===Number(staffId)&&x.month===month);
}

function openAttendance(staffId){
  let s=staff.find(x=>Number(x.id)===Number(staffId));
  if(!s) return;

  attendanceStaffId=s.id;
  document.getElementById("attendanceTitle").innerText="Attendance - "+s.name;

  let now=new Date();
  document.getElementById("aMonth").value=
    now.getFullYear()+"-"+String(now.getMonth()+1).padStart(2,"0");

  document.getElementById("attendanceModal").style.display="block";
  renderAttendance();
}

function closeAttendance(){
  document.getElementById("attendanceModal").style.display="none";
  attendanceStaffId=null;
}

function renderAttendance(){
  let body=document.getElementById("attendanceBody");
  if(!body||!attendanceStaffId) return;

  let month=document.getElementById("aMonth").value;
  let days=workingDaysInMonth(month);
  let saved=getStaffAttendance(attendanceStaffId,month);
  let records=saved?saved.records:{};

  let present=Object.values(records).filter(x=>x==="Present").length;
  let absent=Object.values(records).filter(x=>x==="Absent").length;
  let s=staff.find(x=>Number(x.id)===Number(attendanceStaffId));
  let salary=Number(s?s.salary:0);
  let perDay=days?salary/days:0;
  let earned=Math.round(perDay*present);

  let html=`
    <div class="note" style="background:#f5efff">
      <b>Present:</b> ${present}
      &nbsp; | &nbsp; <b>Absent:</b> ${absent}
      &nbsp; | &nbsp; <b>Estimated Salary:</b> ${money(earned)}
    </div>`;

  for(let d=1;d<=days;d++){
    let value=records[String(d)]||"Present";
    html+=`
      <div style="display:grid;grid-template-columns:70px 1fr;gap:10px;align-items:center;margin-bottom:8px">
        <b>Day ${d}</b>
        <select id="att_${d}">
          <option ${value==="Present"?"selected":""}>Present</option>
          <option ${value==="Absent"?"selected":""}>Absent</option>
        </select>
      </div>`;
  }
  body.innerHTML=html;
}

function saveAttendance(){
  if(!attendanceStaffId) return;
  let month=document.getElementById("aMonth").value;
  if(!month){alert("Select month.");return;}

  let days=workingDaysInMonth(month);
  let records={};

  for(let d=1;d<=days;d++){
    let el=document.getElementById("att_"+d);
    records[String(d)]=el?el.value:"Absent";
  }

  let i=attendance.findIndex(
    x=>Number(x.staffId)===Number(attendanceStaffId)&&x.month===month
  );

  let item={
    id:i>=0?attendance[i].id:Date.now(),
    staffId:attendanceStaffId,
    month,
    records,
    savedAt:new Date().toISOString()
  };

  if(i>=0) attendance[i]=item;
  else attendance.push(item);

  saveStaffData();
  renderAttendance();
  updateUI();
  alert("Attendance saved successfully!");
}

/* =========================
   EXPENSES
========================= */

function openExpense(){

  document.getElementById("expenseModal")
    .style.display="block";

  document.getElementById("ePurpose").value="";
  document.getElementById("eAmount").value="";
  document.getElementById("eDate").value=
    new Date().toISOString().split("T")[0];

}


function closeExpense(){

  document.getElementById("expenseModal")
    .style.display="none";

}


function saveExpense(){

  let purpose =
    document.getElementById("ePurpose").value.trim();

  let amount =
    Number(document.getElementById("eAmount").value||0);

  let date =
    document.getElementById("eDate").value;

  let source =
    document.getElementById("eSource").value;

  let status =
    document.getElementById("eStatus").value;


  if(!purpose){

    alert("Enter expense purpose.");

    return;

  }

  if(amount<=0){

    alert("Enter valid amount.");

    return;

  }


  expenses.push({

    id:Date.now(),

    purpose,

    amount,

    date,

    source,

    status

  });


  saveData();

  closeExpense();

  updateUI();

  alert("Expense saved.");

}


function deleteExpense(id){

  if(!confirm("Delete expense?")) return;

  expenses =
    expenses.filter(e=>e.id!==id);

  saveData();

  updateUI();

}


function renderExpenses(){

  let box =
    document.getElementById("expenseList");


  if(!expenses.length){

    box.innerHTML=
      '<div class="empty">No expenses yet.</div>';

    return;

  }


  let list =
    [...expenses].sort((a,b)=>
      b.date.localeCompare(a.date)
    );


  box.innerHTML=list.map(e=>`

    <div class="card" style="margin-bottom:10px">

      <h3>${escapeHTML(e.purpose)}</h3>

      <p>📅 ${formatDate(e.date)}</p>

      <p>💰 <b>${money(e.amount)}</b></p>

      <p>Source: ${escapeHTML(e.source)}</p>

      <p>Status:
        <span class="badge ${
          e.status==="Settled" ? "paid":"pending"
        }">
          ${e.status}
        </span>
      </p>

      <br>

      <button class="danger"
        onclick="deleteExpense(${e.id})">
        Delete
      </button>

    </div>

  `).join("");

}


/* =========================
   NOTES
========================= */

function addNote(){

  let text =
    document.getElementById("noteText")
    .value.trim();


  if(!text){

    alert("Write a note first.");

    return;

  }


  notes.unshift({

    id:Date.now(),

    text,

    date:new Date().toISOString()

  });


  document.getElementById("noteText").value="";

  saveData();

  renderNotes();

}


function deleteNote(id){

  notes =
    notes.filter(n=>n.id!==id);

  saveData();

  renderNotes();

}


function renderNotes(){

  let box =
    document.getElementById("noteList");


  if(!notes.length){

    box.innerHTML=
      '<div class="empty">No notes.</div>';

    return;

  }


  box.innerHTML=notes.map(n=>`

    <div class="note">

      <p>${escapeHTML(n.text)}</p>

      <br>

      <small>
        ${new Date(n.date).toLocaleString("en-IN")}
      </small>

      <br><br>

      <button class="danger"
        onclick="deleteNote(${n.id})">
        Delete
      </button>

    </div>

  `).join("");

}


/* =========================
   REPORTS
========================= */

function renderReports(){

  let total =
    bookings.reduce(
      (sum,b)=>sum+Number(b.total||0),0
    );

  let received =
    bookings.reduce(
      (sum,b)=>sum+getPaidAmount(b),0
    );

  let pending =
    bookings.reduce(
      (sum,b)=>sum+Number(b.balance||0),0
    );

  let exp =
    expenses
      .filter(e=>e.status==="Settled")
      .reduce(
        (sum,e)=>sum+Number(e.amount||0),0
      );


  document.getElementById("reportTotal")
    .innerText=money(total);

  document.getElementById("reportReceived")
    .innerText=money(received);

  document.getElementById("reportPending")
    .innerText=money(pending);

  document.getElementById("reportExpenses")
    .innerText=money(exp);

  document.getElementById("rIncome")
    .innerText=money(received);

  document.getElementById("rExpense")
    .innerText=money(exp);

  document.getElementById("rBalance")
    .innerText=money(received-exp);

}


/* =========================
   DASHBOARD
========================= */

function renderDashboard(){

  let today =
    new Date().toISOString().split("T")[0];


  let now =
    new Date();


  let month =
    now.getMonth();

  let year =
    now.getFullYear();


  let todayCount =
    bookings.filter(b=>b.date===today).length;


  let monthCount =
    bookings.filter(b=>{

      let d=new Date(b.date);

      return d.getMonth()===month &&
             d.getFullYear()===year;

    }).length;


  let received =
    bookings.reduce(
      (s,b)=>s+Number(b.advance||0),0
    );


  let pending =
    bookings.reduce(
      (s,b)=>s+Number(b.balance||0),0
    );


  document.getElementById("todayCount")
    .innerText=todayCount;

  document.getElementById("monthCount")
    .innerText=monthCount;

  document.getElementById("receivedAmount")
    .innerText=money(received);

  document.getElementById("pendingAmount")
    .innerText=money(pending);

}


